  "author": "KDL System",
  "license": "Proprietary",
  "dependencies": {
    "@kdl/ai-director": "file:../ai-director",
    "@kdl/bootstrap": "file:../bootstrap",
    "@kdl/builder": "file:../builder",
    "@kdl/inspiration": "file:../inspiration",
    "@kdl/orchestrator": "file:../orchestrator",
    "@kdl/reviewer": "file:../reviewer",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
