{
  "name": "@kdl/cli",
  "version": "1.0.0",
  "description": "Official CLI for KDL Landing Framework — Software Operating System",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "bin": {
    "kdl": "./bin/kdl.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node ./bin/kdl.js",
    "test": "node --import tsx scripts/test-runner.mjs"
  },
  "keywords": [
    "kdl",
