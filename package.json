{
  "name": "@kdl/framework-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "KDL Landing Framework — Software Operating System Monorepo",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "node --import tsx tests/e2e/e2e-pipeline.test.ts && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm typecheck",
    "clean": "node -e \"['packages/bootstrap/dist','packages/inspiration/dist','packages/ai-director/dist','packages/builder/dist','packages/reviewer/dist','packages/orchestrator/dist','packages/cli/dist'].forEach(d => require('fs').rmSync(d, {recursive: true, force: true}))\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "playwright": "^1.62.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
